# Copy this file to `.env.local` for local development.
# Never commit real credentials.

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL connection string from a Vercel Marketplace integration.
# Recommended: Prisma Postgres (or another Vercel Marketplace Postgres provider).
# Vercel does not provide a built-in persistent PostgreSQL database by itself.
#
# Local example after you copy the string from the Vercel dashboard:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
#
# Leave unset until the database is connected. The app will still start.
# Persistence features will not work until this is a real PostgreSQL URL.
DATABASE_URL=

# Added in later phases (do not invent values):
# AUTH_SECRET=

# Email Provider Configuration
# Choose one of: 'gmail', 'resend', or 'preview'.
# If omitted: selects 'preview' if EMAIL_DEV_MODE=preview, else 'gmail' if credentials are set,
# else 'resend' if key is set, else 'preview' in development.
# EMAIL_PROVIDER=gmail
#
# Option A: Gmail SMTP Configuration (No custom domain required)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the username and app password below (spaces are automatically stripped):
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# Option B: Resend Configuration
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=TaskFlow <notifications@yourdomain.com>
#
# Option C: Local Development Email Preview Mode
# Captures all emails locally in memory and displays subject, rendered HTML, text, and invite link.
# EMAIL_DEV_MODE=preview
#
# Optional Real-Email Integration Test (Skipped by default in npm test)
# Set RUN_REAL_EMAIL_TEST=1 and specify your test recipient to verify real Gmail delivery:
# RUN_REAL_EMAIL_TEST=0
# REAL_EMAIL_TEST_RECIPIENT=your-test-recipient@example.com
